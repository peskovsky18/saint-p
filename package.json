{
  "name": "spb-izo",
  "version": "0.1.0",
  "description": "Isometric pixel-art map of Saint Petersburg drawn live in the browser from open data",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
