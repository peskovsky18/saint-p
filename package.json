  },
  "dependencies": {
    "earcut": "^3.2.4",
    "suncalc": "^2.1.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/suncalc": "^1.9.2",
    "@types/three": "^0.187.0",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
